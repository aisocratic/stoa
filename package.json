{
  "name": "@aisocratic/stoa",
  "version": "0.1.0",
  "description": "The AI Socratic design system: tokens, a Tailwind v4 theme, and React primitives",
  "license": "MIT",
  "author": "AI Socratic (https://aisocratic.org)",
  "homepage": "https://github.com/aisocratic/stoa",
  "repository": { "type": "git", "url": "git+https://github.com/aisocratic/stoa.git" },
  "keywords": ["design-system", "design-tokens", "tailwindcss", "tailwind-v4", "shadcn", "react"],
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "skill", "README.md", "LICENSE", "CHANGELOG.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./cn": { "types": "./dist/cn.d.ts", "default": "./dist/cn.js" },
    "./control-variants": { "types": "./dist/control-variants.d.ts", "default": "./dist/control-variants.js" },
    "./components/*": { "types": "./dist/components/*.d.ts", "default": "./dist/components/*.js" },
    "./brand": { "types": "./dist/brand/index.d.ts", "default": "./dist/brand/index.js" },
    "./tokens": { "types": "./dist/tokens/index.d.ts", "default": "./dist/tokens/index.js" },
    "./tokens.json": "./dist/tokens.json",
    "./native": { "types": "./dist/native.d.ts", "default": "./dist/native.js" },
    "./tailwind.css": "./dist/css/tailwind.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm build && pnpm test",
    "site:dev": "pnpm --filter stoa-site dev",
    "site:build": "pnpm --filter stoa-site build",
    "site:smoke": "pnpm --filter stoa-site test:e2e",
    "prepublishOnly": "pnpm verify"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": { "node": ">=22.6" },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.3.3"
  },
  "peerDependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "cmdk": "^1.0.4",
    "lucide-react": ">=1",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2",
    "tailwindcss": ">=4.1"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-avatar": { "optional": true },
    "@radix-ui/react-checkbox": { "optional": true },
    "@radix-ui/react-dialog": { "optional": true },
    "@radix-ui/react-dropdown-menu": { "optional": true },
    "@radix-ui/react-label": { "optional": true },
    "@radix-ui/react-popover": { "optional": true },
    "@radix-ui/react-progress": { "optional": true },
    "@radix-ui/react-scroll-area": { "optional": true },
    "@radix-ui/react-select": { "optional": true },
    "@radix-ui/react-switch": { "optional": true },
    "@radix-ui/react-tabs": { "optional": true },
    "@radix-ui/react-tooltip": { "optional": true },
    "cmdk": { "optional": true },
    "next-themes": { "optional": true },
    "sonner": { "optional": true },
    "tailwindcss": { "optional": true }
  },
  "devDependencies": {
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-tooltip": "1.1.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cmdk": "1.0.4",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.7",
    "typescript": "^5.9",
    "vitest": "^4"
  }
}
