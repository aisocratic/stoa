{
  "name": "@aisocratic/design",
  "version": "0.2.0",
  "description": "The AI Socratic design system: tokens, a Tailwind v4 theme, and React primitives",
  "license": "MIT",
  "author": "AI Socratic (https://aisocratic.org)",
  "homepage": "https://github.com/aisocratic/stoa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aisocratic/stoa.git"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "tailwindcss",
    "tailwind-v4",
    "shadcn",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cn": {
      "types": "./dist/cn.d.ts",
      "default": "./dist/cn.js"
    },
    "./control-variants": {
      "types": "./dist/control-variants.d.ts",
      "default": "./dist/control-variants.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./tailwind.css": "./dist/css/tailwind.css",
    "./tokens.css": "./dist/css/tokens.css",
    "./package.json": "./package.json",
    "./site.css": "./dist/css/site.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:dist": "pnpm build && vitest run tests/dist.test.ts",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "site:dev": "pnpm --filter aisocratic-design-site dev",
    "site:build": "pnpm --filter aisocratic-design-site build",
    "site:smoke": "pnpm --filter aisocratic-design-site test:e2e",
    "prepublishOnly": "pnpm verify"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.3.3"
  },
  "peerDependencies": {
